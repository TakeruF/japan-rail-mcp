# Optional. Live timetable, fares, and stop data require an Ekispert API Standard Plan key.
EKISPERT_API_KEY=

# Optional saved preferences JSON. Default: ~/.config/japan-rail-mcp/preferences.json
# Loaded at startup; restart after editing. Keep personal settings outside the repository.
# JAPAN_RAIL_PREFERENCES_FILE=/absolute/path/to/preferences.json

# Optional override for testing a compatible proxy. HTTPS is required outside tests.
# EKISPERT_API_BASE_URL=https://api.ekispert.jp/v1
